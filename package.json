{
  "name": "coverdraft",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Static academic cover-page, index, and assignment PDF builder",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-project.mjs",
    "test": "npm run check",
    "test:browser": "python3 tests/browser-smoke.py && python3 tests/accessibility.py",
    "serve": "python3 -m http.server 8080 --directory src",
    "sri": "node scripts/update-sri.mjs",
    "icons": "python3 scripts/generate-icons.py"
  },
  "engines": {
    "node": ">=20"
  }
}
